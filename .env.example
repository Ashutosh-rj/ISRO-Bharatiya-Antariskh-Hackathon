# Environment Variables for LISS-IV Cloud Removal Project

# Bhuvan API Credentials (for LISS-IV downloads)
BHUVAN_USERNAME=your_username
BHUVAN_PASSWORD=your_password

# Copernicus API Credentials (for Sentinel-1/2 downloads)
COPERNICUS_USER=your_copernicus_user
COPERNICUS_PASSWORD=your_copernicus_password

# Paths
DATA_DIR=data
MODEL_WEIGHTS_DIR=models

# Execution Mode
DEVICE=cpu # Force CPU-only for hackathon requirement
